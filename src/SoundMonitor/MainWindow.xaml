<Window x:Class="SoundMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:SoundMonitor.ViewModels"
        xmlns:converters="clr-namespace:SoundMonitor.Converters"
        mc:Ignorable="d"
        Title="麦克风分贝监控器"
        Height="600" Width="800"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <converters:DecibelToColorConverter x:Key="LevelToColorConverter"/>
        <converters:BoolToButtonTextConverter x:Key="BoolToTextConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#1976D2"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Cursor" Value="No"/>
                    <Setter Property="ForceCursor" Value="True"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidatedInputBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <EventSetter Event="GotKeyboardFocus" Handler="OnInputBoxGotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnInputBoxPreviewMouseLeftButtonDown"/>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="10,0,10,10" FontSize="14">
            <TabItem Header="主页面">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,0,10,0">
                        <TextBlock Text="🎤 麦克风分贝监控器"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="13"
                                   Foreground="Gray"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Left"/>

                        <Border Margin="0,8,0,0"
                                Padding="10,6"
                                CornerRadius="6"
                                Background="#FFF3CD"
                                BorderBrush="#FFC107"
                                BorderThickness="1"
                                Visibility="{Binding IsAlertVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding AlertText}"
                                       Foreground="#8A6D3B"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="麦克风设备:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding Devices}"
                                          SelectedIndex="{Binding SelectedDeviceIndex}"
                                          Width="300" Margin="0,0,20,0"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{Binding IsMonitoring, Converter={StaticResource BoolToTextConverter}}"
                                    Command="{Binding ToggleMonitoringCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="120"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{Binding CurrentLevel, Converter={StaticResource LevelToColorConverter}}"
                                        CornerRadius="10"
                                        Padding="18,16,18,12"
                                        Height="170"
                                        Width="220"
                                        HorizontalAlignment="Center">
                                    <Viewbox Stretch="Uniform" Margin="0,6,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentDecibel, StringFormat={}{0:F1}}"
                                                       FontSize="62"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="dB"
                                                       FontSize="24"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{Binding CurrentLevel, Converter={StaticResource LevelToColorConverter}}"
                                        CornerRadius="5"
                                        Padding="15,8"
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LevelText}"
                                               FontSize="18" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <ProgressBar Grid.Row="2"
                                             Value="{Binding CurrentDecibel}"
                                             Maximum="120"
                                             Height="20"
                                             Margin="0,20,0,0"
                                             Background="#E0E0E0"
                                             Foreground="{Binding CurrentLevel, Converter={StaticResource LevelToColorConverter}}"/>
                                <TextBlock Grid.Row="3"
                                           Text="0                                     120 dB"
                                           FontSize="10"
                                           Foreground="Gray"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="📈 分贝曲线"
                                           FontSize="16" FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding Series}"
                                                    XAxes="{Binding XAxes}"
                                                    YAxes="{Binding YAxes}"
                                                    ZoomMode="X"
                                                    TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#4CAF50" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                                <TextBlock Text="{Binding QuietRangeText}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#2196F3" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                                <TextBlock Text="{Binding NormalRangeText}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#FF9800" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                                <TextBlock Text="{Binding LoudRangeText}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#F44336" CornerRadius="3" Padding="10,5">
                                <TextBlock Text="{Binding DangerRangeText}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="设置页面">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="监控参数设置"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="打开日志"
                                    Command="{Binding OpenLogCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="100"
                                    Padding="12,6"/>
                        </Grid>
                        <TextBlock Text="可修改分段阈值与通知阈值，修改后点击应用设置才会生效。"
                                   Margin="0,6,0,12"
                                   Foreground="Gray"/>

                        <Border Padding="10,8"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                BorderThickness="1"
                                BorderBrush="#D7E3F4"
                                Background="#F7FAFF">
                            <StackPanel>
                                <CheckBox Content="开机自启"
                                          IsChecked="{Binding IsAutoStartEnabled}"
                                          FontWeight="SemiBold"
                                          Foreground="#333"/>
                                <TextBlock Text="将当前用户注册到 Windows 自启动项，开机后自动打开应用。"
                                           Margin="22,4,0,0"
                                           Foreground="Gray"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding AutoStartStatusText}"
                                           Margin="22,2,0,0"
                                           Foreground="#607D8B"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="阈值预览"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                        <Border Padding="10,10"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                BorderThickness="1"
                                Background="#FAFAFA"
                                BorderBrush="#E0E0E0">
                            <WrapPanel>
                                <Border Background="#4CAF50" CornerRadius="3" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PreviewQuietRangeText}" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#2196F3" CornerRadius="3" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PreviewNormalRangeText}" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#FF9800" CornerRadius="3" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PreviewLoudRangeText}" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#F44336" CornerRadius="3" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding PreviewDangerRangeText}" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                        </Border>

                        <TextBlock Text="{Binding SettingsValidationMessage}"
                                   Margin="0,0,0,10"
                                   Foreground="#D32F2F"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <WrapPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="安静上限(dB)" FontSize="12" Foreground="Gray"/>
                                <TextBox Text="{Binding QuietMaxInput, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ValidatedInputBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuietInputIsValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="正常上限(dB)" FontSize="12" Foreground="Gray"/>
                                <TextBox Text="{Binding NormalMaxInput, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ValidatedInputBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NormalInputIsValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="嘈杂上限(dB)" FontSize="12" Foreground="Gray"/>
                                <TextBox Text="{Binding LoudMaxInput, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ValidatedInputBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LoudInputIsValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="通知阈值" FontSize="12" Foreground="Gray"/>
                                <ComboBox SelectedIndex="{Binding NotificationThresholdIndex}" Width="160">
                                    <ComboBoxItem Content="安静及以上"/>
                                    <ComboBoxItem Content="正常及以上"/>
                                    <ComboBoxItem Content="嘈杂及以上"/>
                                    <ComboBoxItem Content="危险及以上"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <Border Padding="10,8"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="BorderBrush" Value="#81C784"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnsavedSettings}" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="BorderBrush" Value="#FFB74D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SettingsSyncHintText}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnsavedSettings}" Value="True">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="100" Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Cursor" Value="Arrow"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewValid}" Value="False">
                                                <Setter Property="Cursor" Value="No"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Button Content="应用设置"
                                        Command="{Binding ApplySettingsCommand}"
                                        IsEnabled="{Binding CanApplySettings}"
                                        Width="100">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnsavedSettings}" Value="True">
                                                    <Setter Property="Background" Value="#FB8C00"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasUnsavedSettings}" Value="True"/>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#EF6C00"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsPreviewValid}" Value="False">
                                                    <Setter Property="Background" Value="#E53935"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
