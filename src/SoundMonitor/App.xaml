<Application x:Class="SoundMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 安静：绿色 -->
            <SolidColorBrush x:Key="QuietBrush" Color="#4CAF50"/>
            <!-- 正常：蓝色 -->
            <SolidColorBrush x:Key="NormalBrush" Color="#2196F3"/>
            <!-- 嘈杂：橙色 -->
            <SolidColorBrush x:Key="LoudBrush" Color="#FF9800"/>
            <!-- 危险：红色 -->
            <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>

            <Style x:Key="MeterStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#BDBDBD"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
